{% extends "layout.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageTitle %}Check your answers{% endblock %}

{% block beforeContent %}
<nav aria-label="Back">
{{ govukBackLink({ text: "Back", href: "/pay-council-tax/account" }) }}
</nav>
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-xl">Check your answers</h1>

    {{ govukSummaryList({
      rows: [
        {
          key: { text: "Full name" },
          value: { text: answers.fullName },
          actions: { items: [{ href: "/pay-council-tax/details", text: "Change", visuallyHiddenText: "full name" }] }
        },
        {
          key: { text: "Email address" },
          value: { text: answers.email },
          actions: { items: [{ href: "/pay-council-tax/details", text: "Change", visuallyHiddenText: "email address" }] }
        },
        {
          key: { text: "Date of birth" },
          value: { text: dobFormatted },
          actions: { items: [{ href: "/pay-council-tax/details", text: "Change", visuallyHiddenText: "date of birth" }] }
        },
        {
          key: { text: "Council tax account number" },
          value: { text: answers.accountNumber },
          actions: { items: [{ href: "/pay-council-tax/account", text: "Change", visuallyHiddenText: "council tax account number" }] }
        },
        {
          key: { text: "Amount to pay" },
          value: { text: amountToPay }
        }
      ]
    }) }}

    {{ govukInsetText({ text: "This is a demo service. No payment will be taken." }) }}

    <form method="post" action="/pay-council-tax/check-answers">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <h2 class="govuk-heading-m">Now send your payment</h2>
      <p class="govuk-body">By submitting this you are confirming that, to the best of your knowledge, the details you are providing are correct.</p>
      {{ govukButton({ text: "Accept and send" }) }}
    </form>
  </div>
</div>
{% endblock %}
