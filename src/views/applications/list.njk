{% extends "layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "moj/components/filter/macro.njk" import mojFilter %}

{% block pageTitle %}Applications{% endblock %}

{# Caseworker-only. MoJ's bundle inlines its own copy of GOV.UK Frontend, so this runs
   alongside the layout's GOV.UK initAll rather than replacing it - MoJ's does not
   initialise GOV.UK components, and the header and service navigation would stop
   working.

   The one component, constructed directly, rather than MoJ's initAll. Verified against
   version 10 in a browser: initAll iterates a hardcoded list that omits
   FilterToggleButton entirely, so it returns cleanly having built nothing - the button
   simply never appears. The list does include SortableTable, which would then wire
   itself to any table we later mark up, which CBLT-137 deliberately avoids. #}
{% block pageScripts %}
  <script type="module" nonce="{{ cspNonce }}" src="/javascripts/moj-frontend.min.js"></script>
  <script type="module" nonce="{{ cspNonce }}">
    import { FilterToggleButton } from '/javascripts/moj-frontend.min.js'

    // Absent whenever there is nothing to filter.
    const filter = document.querySelector('[data-module="moj-filter"]')
    if (filter) {
      new FilterToggleButton(filter)
    }
  </script>
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <h1 class="govuk-heading-xl">Applications</h1>

    {% if showControls %}
      {# mojSearch's template hardcodes its govukInput call and never forwards `value`,
         so the macro cannot echo the search term back (@ministryofjustice/frontend
         10.0.1). This is that template with the one parameter it omits - keep it
         composed rather than reverting to the macro. #}
      <div class="moj-search">
        <form action="/applications" method="get">
          {# Each form carries every other control's state, so using one cannot
             discard the others. #}
          {% for service in selectedServices %}
            <input type="hidden" name="service" value="{{ service }}">
          {% endfor %}
          {% if activeOrder %}
            <input type="hidden" name="sort" value="{{ activeOrder.sort }}">
            <input type="hidden" name="direction" value="{{ activeOrder.direction }}">
          {% endif %}

          {{ govukInput({
            classes: "moj-search__input",
            label: { classes: "moj-search__label", text: "Search by applicant name" },
            id: "applicant-name",
            name: "name",
            type: "search",
            value: searchName,
            attributes: { maxlength: maxNameLength }
          }) }}

          {{ govukButton({ classes: "moj-search__button", text: "Search" }) }}
        </form>

        {# The component's native clear control is unreachable by keyboard and screen
           reader, so a search is only escapable through this link. #}
        {% if searchName %}
          <p class="govuk-body govuk-!-margin-top-2">
            <a class="govuk-link" href="{{ clearSearchHref }}">Clear search</a>
          </p>
        {% endif %}
      </div>

      {% set serviceOptionsHtml %}
        {{ govukCheckboxes({
          idPrefix: "service",
          name: "service",
          fieldset: { legend: { text: "Service", classes: "govuk-fieldset__legend--s" } },
          items: serviceCheckboxes
        }) }}
      {% endset %}

      {# The toggle button is created by MoJ's JavaScript and appended here. Empty
         without scripting, which is why the panel below is never hidden server-side. #}
      <div class="moj-action-bar">
        <div class="moj-action-bar__filter"></div>
      </div>

      <form action="/applications" method="get" class="govuk-!-margin-bottom-6">
        {% if searchName %}
          <input type="hidden" name="name" value="{{ searchName }}">
        {% endif %}
        {% if activeOrder %}
          <input type="hidden" name="sort" value="{{ activeOrder.sort }}">
          <input type="hidden" name="direction" value="{{ activeOrder.direction }}">
        {% endif %}

        {# mojFilter puts `optionsHtml` through `| safe`. Sound here, and only because of
           what this block is: one macro call over the server-defined service list, with
           no request data reaching it. The checkbox labels and values are ours. #}
        {# data-start-hidden="false" is load-bearing. The component defaults it to true
           and applies it *after* its media-query check rather than as the starting
           point, so the default collapses the panel on desktop too. False lets the
           media query decide: collapsed on narrow, open on wide. #}
        {{ mojFilter({
          heading: { text: "Filter" },
          selectedFilters: selectedFilters,
          submit: { text: "Apply filters" },
          optionsHtml: serviceOptionsHtml,
          attributes: { "data-start-hidden": "false" }
        }) }}
      </form>
    {% endif %}

    {% if applications.length %}
      {% set tableRows = [] %}
      {% for application in applications %}
        {# govukTable takes only `text` or `html` per cell, so the reference link is
           built here, where autoescaping applies to the interpolated reference.
           Nunjucks has no statement form, so `push` has to land in a discarded binding. #}
        {% set referenceCell %}<a class="govuk-link" href="/applications/{{ application.reference }}">{{ application.reference }}</a>{% endset %}
        {% set appended = tableRows.push([
          { text: application.fullName },
          { html: referenceCell },
          { text: application.submittedFormatted }
        ]) %}
      {% endfor %}

      {# No data-module="moj-sortable-table" here, deliberately. MoJ's sortable
         table reorders rows in the DOM, so it would sort only the page on screen
         once pagination lands, and do nothing at all with JavaScript off. Sorting
         happens in the query; we keep the component's aria-sort contract and
         drop its script. #}
      {% set headCells = [] %}
      {% for heading in tableHead %}
        {% if heading.href %}
          {% set headingLink %}<a class="govuk-link govuk-link--no-visited-state" href="{{ heading.href }}">{{ heading.text }}</a>{% endset %}
          {% set appended = headCells.push({
            html: headingLink,
            attributes: { "aria-sort": heading.ariaSort }
          }) %}
        {% else %}
          {% set appended = headCells.push({ text: heading.text }) %}
        {% endif %}
      {% endfor %}

      {{ govukTable({
        caption: tableCaption,
        captionClasses: "govuk-visually-hidden",
        head: headCells,
        rows: tableRows
      }) }}
    {% elif showControls %}
      <p class="govuk-body">{{ noMatchesMessage }}</p>
    {% else %}
      <p class="govuk-body">There are no applications yet.</p>
    {% endif %}
  </div>
</div>
{% endblock %}
